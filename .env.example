# Скопируй этот файл в `.env` рядом со скриптом и заполни значения.
# Файл `.env` не попадает в git (см. .gitignore).

# Токен бота от @BotFather (обязательно!)
TG_TOKEN=123456789:AAABBBCCC

# ID Google-таблицы с базой (из ссылки docs.google.com/spreadsheets/d/<ID>/edit)
SPREADSHEET_ID=1RaHoS_8Ov-kNKSZJK015ceC6H3fsWnW-D-8Yee4ckQI

# Telegram ID админа (команда /admin)
ADMIN_ID=6106999216

# Ссылка на Telegram-канал с новостями города (кнопка «📰 Новости города»)
NEWS_CHANNEL_URL=https://t.me/Sevastopol_AI

# Как часто обновлять кэш таблицы, в секундах
REFRESH_SECONDS=600

# Файл для хранения XP-паспортов и статистики между перезапусками
STATE_FILE=bot_state.json

# ─────────────────────────────────────────────────────────────────
# Форвардер постов каналов (events/forwarder.py) — ОТДЕЛЬНЫЙ бот!
# Токен ВТОРОГО бота от @BotFather (не тот же, что TG_TOKEN выше).
# Скрипт читает и events/.env, и этот файл.
#FORWARDER_BOT_TOKEN=123456789:AAABBBCCC

# id личного чата владельца для копируемых постов (или см. events/sources.json)
#FORWARDER_TARGET_CHAT_ID=6106999216
