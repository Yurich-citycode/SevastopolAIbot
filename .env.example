# Скопируй этот файл в `.env` рядом со скриптом и заполни значения.
# Файл `.env` не попадает в git (см. .gitignore).

# Токен бота от @BotFather (обязательно!)
TG_TOKEN=123456789:AAABBBCCC

# ID Google-таблицы с базой (из ссылки docs.google.com/spreadsheets/d/<ID>/edit)
SPREADSHEET_ID=1RaHoS_8Ov-kNKSZJK015ceC6H3fsWnW-D-8Yee4ckQI

# Telegram ID админа (команда /admin)
ADMIN_ID=6106999216

# Ссылка на Telegram-канал с новостями города (кнопка «📰 Новости города»)
NEWS_CHANNEL_URL=https://t.me/Sevastopol_AI

# Веб-форма «✍️ Предложить место» (suggest.html на GitHub Pages)
SUGGEST_FORM_URL=https://yurich-citycode.github.io/SevastopolAIbot/suggest.html

# Как часто обновлять кэш таблицы, в секундах
REFRESH_SECONDS=600

# Файл для хранения XP-паспортов и статистики между перезапусками
STATE_FILE=bot_state.json

# ─────────────────────────────────────────────────────────────────
# Парсер каналов (events/forwarder.py) — работает от ЛИЧНОГО аккаунта
# через Telethon, отдельный сервис, к боту отношения не имеет.
# API_ID / API_HASH берутся на https://my.telegram.org → API development tools.
# Скрипт читает и events/.env, и этот файл (лучше держать их в events/.env).
#TELETHON_API_ID=12345678
#TELETHON_API_HASH=0123456789abcdef0123456789abcdef

# Строка сессии — выдаёт команда:  python events/forwarder.py login --save
# ⚠️ Это ПОЛНЫЙ доступ к аккаунту: не публикуй и не коммить.
#TELETHON_SESSION=

# Куда копировать посты каналов: me = «Избранное» аккаунта (по умолчанию),
# либо @username / https://t.me/username / числовой id чата.
#FORWARDER_TARGET=me
