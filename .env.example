# Шаблон настроек. Скопируй в `.env` рядом со скриптом и заполни:
#   cp .env.example .env && chmod 600 .env
# `.env` в git не попадает (см. .gitignore). Вместо файла можно задавать те же
# переменные окружением: docker -e, systemd EnvironmentFile, GitHub Secrets,
# Railway/Render ENV, Vault, Doppler. Реальное окружение всегда приоритетнее .env.

# Токен бота от @BotFather (обязательно, секрет)
TG_TOKEN=123456789:AAABBBCCC

# ID Google-таблицы с базой (из ссылки docs.google.com/spreadsheets/d/<ID>/edit)
SPREADSHEET_ID=1RaHoS_8Ov-kNKSZJK015ceC6H3fsWnW-D-8Yee4ckQI

# Твой Telegram ID (обязательно для /admin и пересылки заявок с формы).
# Узнать: напиши @userinfobot. Значения по умолчанию нет — только ENV.
ADMIN_ID=

# Ссылка на Telegram-канал с новостями города (кнопка «📰 Новости города»)
NEWS_CHANNEL_URL=https://t.me/Sevastopol_AI

# Веб-форма «✍️ Предложить место» (suggest.html на GitHub Pages)
SUGGEST_FORM_URL=https://yurich-citycode.github.io/SevastopolAIbot/suggest.html

# Как часто обновлять кэш таблицы, в секундах
REFRESH_SECONDS=600

# Файл для хранения XP-паспортов и статистики между перезапусками
STATE_FILE=bot_state.json
