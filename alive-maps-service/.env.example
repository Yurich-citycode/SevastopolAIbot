# Севастопольский экстракт: ~39 МБ, обновляется Geofabrik ежедневно
# PBF_URL=https://download.geofabrik.de/russia/crimean-fed-district-latest.osm.pbf

# Порт, на котором открывается сервис
PORT=8080

# Память JVM
GH_MEMORY=2g
PLANETILER_MEMORY=4g

# Версии (пины, чтобы сборка была воспроизводимой)
GH_VERSION=11.1
# TileServer GL: latest проверен; можно запинить тегом с Docker Hub
TS_VERSION=latest
PLANETILER_VERSION=latest

# Кэш ответов /api/route в секундах, 0 — выключить
CACHE_TTL=900
