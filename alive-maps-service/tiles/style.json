{
  "version": 8,
  "name": "Sevastopol Alive",
  "metadata": {
    "description": "Тёмная схема Севастополя из локальных тайлов OpenMapTiles (Planetiler + TileServer GL)"
  },
  "glyphs": "/fonts/{fontstack}/{range}.pbf",
  "sources": {
    "osm": {
      "type": "vector",
      "tiles": ["/tiles/{z}/{x}/{y}.pbf"],
      "minzoom": 0,
      "maxzoom": 15,
      "attribution": "Данные © OpenStreetMap"
    }
  },
  "layers": [
    {
      "id": "bg",
      "type": "background",
      "paint": { "background-color": "#0A0B09" }
    },
    {
      "id": "landcover-wood",
      "type": "fill",
      "source": "osm",
      "source-layer": "landcover",
      "filter": ["==", ["get", "class"], "wood"],
      "paint": { "fill-color": "#0F1A0D", "fill-opacity": 0.9 }
    },
    {
      "id": "landuse-residential",
      "type": "fill",
      "source": "osm",
      "source-layer": "landuse",
      "minzoom": 11,
      "filter": ["==", ["get", "class"], "residential"],
      "paint": { "fill-color": "#101208", "fill-opacity": 0.6 }
    },
    {
      "id": "park-fill",
      "type": "fill",
      "source": "osm",
      "source-layer": "park",
      "paint": { "fill-color": "#13200E", "fill-opacity": 0.95 }
    },
    {
      "id": "park-outline",
      "type": "line",
      "source": "osm",
      "source-layer": "park",
      "minzoom": 12,
      "paint": { "line-color": "#1F3320", "line-width": 0.8 }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "osm",
      "source-layer": "water",
      "paint": { "fill-color": "#0C161C" }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "osm",
      "source-layer": "waterway",
      "minzoom": 12,
      "paint": { "line-color": "#16262E", "line-width": 1 }
    },
    {
      "id": "building",
      "type": "fill",
      "source": "osm",
      "source-layer": "building",
      "minzoom": 13,
      "paint": {
        "fill-color": "#15170F",
        "fill-outline-color": "#1E2115",
        "fill-opacity": 0.95
      }
    },
    {
      "id": "road-path",
      "type": "line",
      "source": "osm",
      "source-layer": "transportation",
      "minzoom": 13,
      "filter": ["match", ["get", "class"], ["path", "track"], true, false],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#2B2E20",
        "line-width": ["interpolate", ["linear"], ["zoom"], 13, 0.6, 17, 2],
        "line-dasharray": [2, 2]
      }
    },
    {
      "id": "road-minor",
      "type": "line",
      "source": "osm",
      "source-layer": "transportation",
      "minzoom": 11,
      "filter": ["match", ["get", "class"], ["minor", "service"], true, false],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#262920",
        "line-width": ["interpolate", ["exponential", 1.4], ["zoom"], 11, 0.6, 17, 6]
      }
    },
    {
      "id": "road-major",
      "type": "line",
      "source": "osm",
      "source-layer": "transportation",
      "minzoom": 8,
      "filter": ["match", ["get", "class"], ["primary", "secondary", "tertiary", "trunk", "motorway"], true, false],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#3A3D2C",
        "line-width": ["interpolate", ["exponential", 1.4], ["zoom"], 8, 0.8, 17, 12]
      }
    },
    {
      "id": "place-suburb",
      "type": "symbol",
      "source": "osm",
      "source-layer": "place",
      "minzoom": 11,
      "maxzoom": 16,
      "filter": ["match", ["get", "class"], ["suburb", "neighbourhood", "village", "town"], true, false],
      "layout": {
        "text-field": ["coalesce", ["get", "name"], ["get", "name_en"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 11, 10, 16, 13],
        "text-transform": "uppercase",
        "text-letter-spacing": 0.1
      },
      "paint": {
        "text-color": "#7C8271",
        "text-halo-color": "#0A0B09",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "water-name",
      "type": "symbol",
      "source": "osm",
      "source-layer": "water_name",
      "minzoom": 12,
      "layout": {
        "text-field": ["coalesce", ["get", "name"], ["get", "name_en"]],
        "text-font": ["Noto Sans Italic"],
        "text-size": 11,
        "symbol-placement": "line",
        "symbol-spacing": 600
      },
      "paint": { "text-color": "#3F6B80", "text-halo-color": "#0A0B09", "text-halo-width": 1 }
    },
    {
      "id": "road-name",
      "type": "symbol",
      "source": "osm",
      "source-layer": "transportation_name",
      "minzoom": 14,
      "layout": {
        "text-field": ["coalesce", ["get", "name"], ["get", "name_en"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 14, 9, 17, 12],
        "symbol-placement": "line",
        "symbol-spacing": 350,
        "text-max-angle": 30,
        "text-padding": 2
      },
      "paint": { "text-color": "#8D9280", "text-halo-color": "#0A0B09", "text-halo-width": 1.4 }
    },
    {
      "id": "poi-park-label",
      "type": "symbol",
      "source": "osm",
      "source-layer": "park",
      "minzoom": 13,
      "layout": {
        "text-field": ["coalesce", ["get", "name"], ["get", "name_en"]],
        "text-font": ["Noto Sans Italic"],
        "text-size": 11,
        "text-padding": 4
      },
      "paint": { "text-color": "#6E9C5E", "text-halo-color": "#0A0B09", "text-halo-width": 1.4 }
    }
  ]
}
